# RankBuilder — Environment Variables
# Copy this to .env and fill in real values for local dev.
# PRODUCTION VALUES ARE SET IN COOLIFY UI — NOT HERE.

# ─── Brevo SMTP (all channels use this for email) ───────────────────────────
BREVO_API_KEY=xkeysib-your-key-here
BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email
SENDER_EMAIL=ai@fortressblinds.co.za
SENDER_NAME=FortressBlinds AI
NOTIFY_EMAIL=craig@fortressblinds.co.za

# ─── HARO ───────────────────────────────────────────────────────────────────
HARO_EMAIL=agentdevelopmentops@gmail.com
HARO_PASSWORD=your-haro-app-password

# ─── Connectively ────────────────────────────────────────────────────────────
CONNECTIVELY_EMAIL=agentdevelopmentops@gmail.com
CONNECTIVELY_PASSWORD=your-connectively-password

# ─── Guest Outreach SMTP ────────────────────────────────────────────────────
GUEST_SMTP_HOST=smtp-relay.brevo.com
GUEST_SMTP_PORT=587
GUEST_SMTP_USER=ac9618001@smtp-brevo.com
GUEST_SMTP_PASS=your-brevo-smtp-password

# ─── GitHub (for git ops inside container) ──────────────────────────────────
GITHUB_TOKEN=ghp_your-github-pat

# ─── Container control ──────────────────────────────────────────────────────
RUN_MODE=cron
HEALTHCHECK_PORT=8080
