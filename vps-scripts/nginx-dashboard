# HTTP → redirect to HTTPS
server {
    listen 80;
    server_name dashboard.fortressblinds.co.za;
    return 301 https://$server_name$request_uri;
}

# HTTPS
server {
    listen 443 ssl;
    server_name dashboard.fortressblinds.co.za;

    ssl_certificate /etc/letsencrypt/live/fortressblinds.co.za/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fortressblinds.co.za/privkey.pem;

    # Serve built frontend static files
    root /var/www/crm-frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API calls to FastAPI backend
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
